---
current: races
---
<div class="topline"><span>{{ t("intro.crumbs") }}</span><span class="pill">{{ t("intro.pill") }}</span></div>

<div class="page-heading">
  <div>
    <div class="eyebrow">{{ t("intro.eyebrow") }}</div>
    <h1>{{ t("intro.h1") }}</h1>
  </div>
  <p class="lede">{{ t("intro.lede") }}</p>
</div>

<section id="races" aria-labelledby="races-h">
  <div class="section-heading"><h2 id="races-h">{{ t("races.title") }}</h2><span>{{ t("races.subtitle") }}</span></div>
  <div class="grid-4">
    <article class="card race">
      <div class="slot"><strong>{{ t("races.strong") }}</strong><small>{{ t("races.small") }}</small></div>
      <div class="race-body">
        <h3>{{ t("races.h3_1") }}</h3>
        <span class="tag stub">{{ t("common:tag.notDesigned") }}</span>
        <p>{{ t("races.p1") }}</p>
      </div>
    </article>
    <article class="card race">
      <div class="slot"><strong>{{ t("races.strong") }}</strong><small>{{ t("races.small") }}</small></div>
      <div class="race-body">
        <h3>{{ t("races.h3_2") }}</h3>
        <span class="tag stub">{{ t("common:tag.notDesigned") }}</span>
        <p>{{ t("races.p1") }}</p>
      </div>
    </article>
    <article class="card race">
      <div class="slot"><strong>{{ t("races.strong") }}</strong><small>{{ t("races.small") }}</small></div>
      <div class="race-body">
        <h3>{{ t("races.h3_3") }}</h3>
        <span class="tag stub">{{ t("common:tag.notDesigned") }}</span>
        <p>{{ t("races.p1") }}</p>
      </div>
    </article>
    <article class="card race">
      <div class="slot"><strong>{{ t("races.strong") }}</strong><small>{{ t("races.small") }}</small></div>
      <div class="race-body">
        <h3>{{ t("races.h3_4") }}</h3>
        <span class="tag stub">{{ t("common:tag.notDesigned") }}</span>
        <p>{{ t("races.p1") }}</p>
      </div>
    </article>
  </div>
  <div class="callout"><p>{{ t("races.p2") }}</p></div>
</section>

<section id="characters" aria-labelledby="characters-h">
  <div class="section-heading"><h2 id="characters-h">{{ t("characters.title") }}</h2><span>{{ t("characters.subtitle") }}</span></div>
  <div class="tbd"><p><strong>{{ t("common:tbd") }}</strong> {{ t("characters.tbd") }}</p></div>
</section>

<nav class="pager" aria-label="{{ t("common:pager.label") }}">
  <a class="prev" href="world.html"><small>{{ t("common:pager.prev") }}</small>{{ t("pager.prev") }}</a>
  <a class="next" href="systems/mana.html"><small>{{ t("common:pager.next") }}</small>{{ t("pager.next") }}</a>
</nav>
