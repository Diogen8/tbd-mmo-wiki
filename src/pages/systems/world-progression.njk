---
current: systems
currentSystem: world-progression
---
<div class="topline"><span>{{ t("intro.crumbs") }}</span><span class="tag draft">{{ t("common:tag.draft") }}</span></div>

<div class="page-heading">
  <div>
    <div class="eyebrow">{{ t("intro.eyebrow") }}</div>
    <h1>{{ t("intro.h1") }}</h1>
  </div>
  <p class="lede">{{ t("intro.lede") }}</p>
</div>

<nav class="toc" aria-label="{{ t("common:toc.title") }}">
  <b>{{ t("common:toc.title") }}</b>
  <ol>
    <li><a href="#core-idea">{{ t("toc.core-idea") }}</a></li>
    <li><a href="#two-layers">{{ t("toc.two-layers") }}</a></li>
    <li><a href="#floor">{{ t("toc.floor") }}</a></li>
    <li><a href="#cities">{{ t("toc.cities") }}</a></li>
    <li><a href="#contracts">{{ t("toc.contracts") }}</a></li>
    <li><a href="#finite">{{ t("toc.finite") }}</a></li>
    <li><a href="#renewal">{{ t("toc.renewal") }}</a></li>
    <li><a href="#discovery">{{ t("toc.discovery") }}</a></li>
