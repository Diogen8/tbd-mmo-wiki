---
current: systems
currentSystem: pvp
---
<div class="topline"><span>{{ t("intro.crumbs") }}</span><span class="tag draft">{{ t("common:tag.draft") }}</span></div>

<div class="page-heading">
  <div>
    <div class="eyebrow">{{ t("intro.eyebrow") }}</div>
    <h1>{{ t("intro.h1") }}</h1>
  </div>
  <p class="lede">{{ t("intro.lede") }}</p>
</div>

<nav class="toc" aria-label="{{ t("common:toc.title") }}">
  <b>{{ t("common:toc.title") }}</b>
  <ol>
    <li><a href="#core-idea">{{ t("toc.core-idea") }}</a></li>
    <li><a href="#ally-tiers">{{ t("toc.ally-tiers") }}</a></li>
    <li><a href="#crime-states">{{ t("toc.crime-states") }}</a></li>
    <li><a href="#mutual-vs-pk">{{ t("toc.mutual-vs-pk") }}</a></li>
    <li><a href="#resource-loss">{{ t("toc.resource-loss") }}</a></li>
    <li><a href="#stolen-cargo">{{ t("toc.stolen-cargo") }}</a></li>
    <li><a href="#escape">{{ t("toc.escape") }}</a></li>
    <li><a href="#sheriffs">{{ t("toc.sheriffs") }}</a></li>
    <li><a href="#pk-points">{{ t("toc.pk-points") }}</a></li>
    <li><a href="#recovery">{{ t("toc.recovery") }}</a></li>
    <li><a href="#refuge">{{ t("toc.refuge") }}</a></li>
    <li><a href="#tracking">{{ t("toc.tracking") }}</a></li>
    <li><a href="#city-wars">{{ t("toc.city-wars") }}</a></li>
    <li><a href="#safeguards">{{ t("toc.safeguards") }}</a></li>
  </ol>
</nav>

<article class="prose">
  <p>{{ t("intro.p") }}</p>

  <h2 id="core-idea">{{ t("core-idea.title") }}</h2>
  <p>{{ t("core-idea.p1") }}</p>
  <p>{{ t("core-idea.p2") }}</p>
  <ul class="chips"><li>{{ t("core-idea.li1") }}</li><li>{{ t("core-idea.li2") }}</li><li>{{ t("core-idea.li3") }}</li><li>{{ t("core-idea.li4") }}</li><li>PK</li></ul>
  <p>{{ t("core-idea.p3") }}</p>

  <h2 id="ally-tiers">{{ t("ally-tiers.title") }}</h2>
  <p>{{ t("ally-tiers.p1") }}</p>
  <ol>
    <li>{{ t("ally-tiers.li1") }}</li>
    <li>{{ t("ally-tiers.li2") }}</li>
    <li>{{ t("ally-tiers.li3") }}</li>
  </ol>
  <p>{{ t("ally-tiers.p2") }}</p>

  <h2 id="crime-states">{{ t("crime-states.title") }}</h2>
</article>
<div class="table-wrap">
  <table>
    <thead><tr><th scope="col">{{ t("crime-states.table.head.c1") }}</th><th scope="col">{{ t("crime-states.table.head.c2") }}</th></tr></thead>
    <tbody>
      <tr><td><strong>{{ t("crime-states.table.r1.c1") }}</strong></td><td>{{ t("crime-states.table.r1.c2") }}</td></tr>
      <tr><td><strong>{{ t("crime-states.table.r2.c1") }}</strong></td><td>{{ t("crime-states.table.r2.c2") }}</td></tr>
      <tr><td><strong>{{ t("crime-states.table.r3.c1") }}</strong></td><td>{{ t("crime-states.table.r3.c2") }}</td></tr>
      <tr><td><strong>{{ t("crime-states.table.r4.c1") }}</strong></td><td>{{ t("crime-states.table.r4.c2") }}</td></tr>
      <tr><td><strong>PK</strong></td><td>{{ t("crime-states.table.r5.c2") }}</td></tr>
    </tbody>
  </table>
</div>
<article class="prose">
  <p>{{ t("crime-states.p1") }}</p>
  <pre class="flow">{{ t("crime-states.pre") }}</pre>
  <p>{{ t("crime-states.p2") }}</p>

  <h2 id="mutual-vs-pk">{{ t("mutual-vs-pk.title") }}</h2>
