---
current: systems
currentSystem: mana
---
<div class="topline"><span>{{ t("intro.crumbs") }}</span><span class="tag draft">{{ t("common:tag.draft") }}</span></div>

<div class="page-heading">
  <div>
    <div class="eyebrow">{{ t("intro.eyebrow") }}</div>
    <h1>{{ t("intro.h1") }}</h1>
  </div>
  <p class="lede">{{ t("intro.lede") }}</p>
</div>

<nav class="toc" aria-label="{{ t("common:toc.title") }}">
  <b>{{ t("common:toc.title") }}</b>
  <ol>
    <li><a href="#core-idea">{{ t("toc.core-idea") }}</a></li>
    <li><a href="#personal-pool">{{ t("toc.personal-pool") }}</a></li>
    <li><a href="#monster-cores">{{ t("toc.monster-cores") }}</a></li>
    <li><a href="#item-upkeep">{{ t("toc.item-upkeep") }}</a></li>
    <li><a href="#vaults">{{ t("toc.vaults") }}</a></li>
  </ol>
</nav>

<article class="prose">
  <p>{{ t("intro.p") }}</p>

  <h2 id="core-idea">{{ t("core-idea.title") }}</h2>
  <p>{{ t("core-idea.p") }}</p>

  <h2 id="personal-pool">{{ t("personal-pool.title") }}</h2>
  <ul>
    <li>{{ t("personal-pool.li1") }}</li>
    <li>{{ t("personal-pool.li2") }}</li>
    <li>{{ t("personal-pool.li3") }}</li>
  </ul>

  <h2 id="monster-cores">{{ t("monster-cores.title") }}</h2>
  <p>{{ t("monster-cores.p1") }}</p>
  <p>{{ t("monster-cores.p2") }}</p>
  <div class="grid-2">
    <div class="card">
      <h3>{{ t("monster-cores.h3_1") }}</h3>
      <p>{{ t("monster-cores.p3") }}</p>
    </div>
    <div class="card">
      <h3>{{ t("monster-cores.h3_2") }}</h3>
      <p>{{ t("monster-cores.p4") }}</p>
    </div>
  </div>
  <p>{{ t("monster-cores.p5") }}</p>

  <h3>{{ t("monster-cores.h3_3") }}</h3>
  <ul>
    <li>{{ t("monster-cores.li1") }}</li>
    <li>{{ t("monster-cores.li2") }}</li>
  </ul>

  <h3>{{ t("monster-cores.h3_4") }}</h3>
  <p>{{ t("monster-cores.p6") }}</p>

  <h2 id="item-upkeep">{{ t("item-upkeep.title") }}</h2>
  <p>{{ t("item-upkeep.p1") }}</p>
  <p>{{ t("item-upkeep.p2") }}</p>

  <h2 id="vaults">{{ t("vaults.title") }}</h2>
  <p>{{ t("vaults.p") }}</p>
  <ul>
    <li>{{ t("vaults.li1") }}</li>
    <li>{{ t("vaults.li2") }}</li>
  </ul>
</article>

<details class="questions">
  <summary>{{ t("vaults.questions.summary") }}</summary>
  <ul>
    <li>{{ t("vaults.questions.li1") }}</li>
    <li class="resolved">{{ t("vaults.questions.li2") }}</li>
    <li>{{ t("vaults.questions.li3") }}</li>
    <li>{{ t("vaults.questions.li4") }}</li>
    <li>{{ t("vaults.questions.li5") }}</li>
  </ul>
</details>

<nav class="pager" aria-label="{{ t("common:pager.label") }}">
  <a class="prev" href="../races.html"><small>{{ t("common:pager.prev") }}</small>{{ t("pager.prev") }}</a>
  <a class="next" href="stats.html"><small>{{ t("common:pager.next") }}</small>{{ t("pager.next") }}</a>
</nav>
