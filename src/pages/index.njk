---
current: concept
---
<div class="topline"><span>{{ t("intro.crumbs") }}</span><span class="pill">{{ t("intro.pill") }}</span></div>

<div class="page-heading">
  <div>
    <div class="eyebrow">{{ t("intro.eyebrow") }}</div>
    <h1>{{ t("intro.h1") }}</h1>
  </div>
  <p class="lede">{{ t("intro.lede") }}</p>
</div>

<figure class="hero">
  <span class="hero-kicker">{{ t("intro.hero-kicker") }}</span>
  <div class="hero-title">TBD <b>MMO</b></div>
  <p class="hero-line">{{ t("intro.hero-line") }}</p>
  <figcaption>{{ t("intro.figcaption") }}</figcaption>
</figure>

<div class="actions">
  <a class="btn primary" href="world.html">{{ t("intro.btn1") }} <span aria-hidden="true">→</span></a>
  <a class="btn" href="#systems">{{ t("intro.btn2") }} <span aria-hidden="true">↓</span></a>
</div>

<div class="stats">
  <div><strong>{{ t("stats.area") }}</strong><span>{{ t("stats.areaNote") }}</span></div>
  <div><strong>4</strong><span>{{ t("stats.racesNote") }}</span></div>
  <div><strong>8</strong><span>{{ t("stats.systemsNote") }}</span></div>
</div>

<section id="concept" aria-labelledby="concept-h">
  <div class="section-heading"><h2 id="concept-h"><span class="num">01</span>{{ t("concept.title") }}</h2><span>{{ t("concept.subtitle") }}</span></div>
  <div class="grid-2">
    <article class="card">
      <div class="eyebrow">{{ t("concept.eyebrow1") }}</div>
      <h3>{{ t("concept.h3_1") }}</h3>
      <p>{{ t("concept.p1") }}</p>
      <p>{{ t("concept.p2") }}</p>
      <p><a href="world.html#cosmology">{{ t("concept.p3") }}</a></p>
    </article>
    <article class="card">
      <div class="eyebrow">{{ t("concept.eyebrow2") }}</div>
      <h3>{{ t("concept.h3_2") }}</h3>
      <div class="tbd"><p><strong>{{ t("common:tbd") }}</strong> {{ t("concept.tbd1") }}</p></div>
      <p>{{ t("concept.p4") }}</p>
    </article>
  </div>
  <div class="grid-3">
    <article class="card">
      <div class="eyebrow">{{ t("concept.eyebrow3") }}</div>
      <h3>{{ t("concept.h3_3") }}</h3>
      <div class="tbd"><p><strong>{{ t("common:tbd") }}</strong> {{ t("concept.tbd2") }}</p></div>
    </article>
    <article class="card">
      <div class="eyebrow">{{ t("concept.eyebrow4") }}</div>
      <h3>{{ t("concept.h3_4") }}</h3>
      <div class="tbd"><p><strong>{{ t("common:tbd") }}</strong> {{ t("concept.tbd3") }}</p></div>
    </article>
    <article class="card">
      <div class="eyebrow">{{ t("concept.eyebrow5") }}</div>
      <h3>{{ t("concept.h3_5") }}</h3>
      <div class="tbd"><p><strong>{{ t("common:tbd") }}</strong> {{ t("concept.tbd4") }}</p></div>
    </article>
  </div>
</section>

<section aria-labelledby="world-h">
  <div class="section-heading"><h2 id="world-h"><span class="num">02</span>{{ t("world.title") }}</h2><span>{{ t("world.subtitle") }}</span></div>
  <div class="grid-4">
    <a class="card" href="world.html#cosmology">
      <div class="card-head"><span class="num">02.1</span><span class="tag draft">{{ t("common:tag.draft") }}</span></div>
      <h3>{{ t("world.h3_1") }}</h3>
      <p>{{ t("world.p1") }}</p>
    </a>
    <a class="card" href="world.html#locations">
      <div class="card-head"><span class="num">02.2</span><span class="tag draft">{{ t("common:tag.draft") }}</span></div>
      <h3>{{ t("world.h3_2") }}</h3>
      <p>{{ t("world.p2") }}</p>
    </a>
    <a class="card" href="world.html#factions">
      <div class="card-head"><span class="num">02.3</span><span class="tag stub">{{ t("common:tag.notDesigned") }}</span></div>
      <h3>{{ t("world.h3_3") }}</h3>
      <p>{{ t("world.p3") }}</p>
    </a>
    <a class="card" href="world.html#timeline">
      <div class="card-head"><span class="num">02.4</span><span class="tag stub">{{ t("common:tag.notDesigned") }}</span></div>
      <h3>{{ t("world.h3_4") }}</h3>
      <p>{{ t("world.p4") }}</p>
    </a>
  </div>
</section>

<section aria-labelledby="races-h">
  <div class="section-heading"><h2 id="races-h"><span class="num">03</span>{{ t("races.title") }}</h2><span>{{ t("races.subtitle") }}</span></div>
  <div class="grid-2">
    <a class="card" href="races.html#races">
      <div class="card-head"><span class="num">03.1</span><span class="tag stub">{{ t("races.span") }}</span></div>
      <h3>{{ t("races.h3_1") }}</h3>
      <p>{{ t("races.p1") }}</p>
      <span class="go">{{ t("races.go1") }}</span>
    </a>
    <a class="card" href="races.html#characters">
      <div class="card-head"><span class="num">03.2</span><span class="tag stub">{{ t("common:tag.notDesigned") }}</span></div>
      <h3>{{ t("races.h3_2") }}</h3>
      <p>{{ t("races.p2") }}</p>
      <span class="go">{{ t("races.go2") }}</span>
    </a>
  </div>
</section>

<section id="systems" aria-labelledby="systems-h">
  <div class="section-heading"><h2 id="systems-h"><span class="num">04</span>{{ t("systems.title") }}</h2><span>{{ t("systems.subtitle") }}</span></div>
  <div class="grid-2">
    <a class="card" href="systems/mana.html">
      <div class="card-head"><span class="num">04.1</span><span class="tag draft">{{ t("common:tag.draft") }}</span></div>
      <h3>{{ t("systems.h3_1") }}</h3>
      <p>{{ t("systems.p1") }}</p>
    </a>
    <a class="card" href="systems/stats.html">
      <div class="card-head"><span class="num">04.2</span><span class="tag draft">{{ t("common:tag.draft") }}</span></div>
      <h3>{{ t("systems.h3_2") }}</h3>
      <p>{{ t("systems.p2") }}</p>
    </a>
    <a class="card" href="systems/combat.html">
      <div class="card-head"><span class="num">04.3</span><span class="tag draft">{{ t("common:tag.draft") }}</span></div>
      <h3>{{ t("systems.h3_3") }}</h3>
      <p>{{ t("systems.p3") }}</p>
    </a>
    <a class="card" href="systems/progression.html">
      <div class="card-head"><span class="num">04.4</span><span class="tag draft">{{ t("common:tag.draft") }}</span></div>
      <h3>{{ t("systems.h3_4") }}</h3>
      <p>{{ t("systems.p4") }}</p>
    </a>
    <a class="card" href="systems/pvp.html">
      <div class="card-head"><span class="num">04.5</span><span class="tag draft">{{ t("common:tag.draft") }}</span></div>
      <h3>{{ t("systems.h3_5") }}</h3>
      <p>{{ t("systems.p5") }}</p>
    </a>
    <a class="card" href="systems/world-progression.html">
      <div class="card-head"><span class="num">04.6</span><span class="tag draft">{{ t("common:tag.draft") }}</span></div>
      <h3>{{ t("systems.h3_6") }}</h3>
      <p>{{ t("systems.p6") }}</p>
    </a>
    <a class="card" href="systems/inventory-economy.html">
      <div class="card-head"><span class="num">04.7</span><span class="tag stub">{{ t("common:tag.stub") }}</span></div>
      <h3>{{ t("systems.h3_7") }}</h3>
      <p>{{ t("systems.p7") }}</p>
    </a>
    <a class="card" href="systems/social-guilds.html">
      <div class="card-head"><span class="num">04.8</span><span class="tag stub">{{ t("common:tag.stub") }}</span></div>
      <h3>{{ t("systems.h3_8") }}</h3>
      <p>{{ t("systems.p8") }}</p>
    </a>
  </div>
</section>

<section id="status" aria-labelledby="status-h">
  <div class="section-heading"><h2 id="status-h"><span class="num">05</span>{{ t("status.title") }}</h2><span>{{ t("status.subtitle") }}</span></div>
  <article class="card">
    <p>{{ t("status.p") }}</p>
  </article>
</section>

<p class="source-note">{{ t("status.source-note") }}</p>
